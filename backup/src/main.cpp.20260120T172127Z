class CpuMonitor {
private:
    long prevIdle = 0;
    long prevTotal = 0;
    
public:
    double getCpuLoad() {
        std::ifstream statFile( "/proc/stat" );
        if ( !statFile.is_open() ) return 0.0;
        
        std::string line;
        std::getline( statFile, line );
        std::istringstream iss( line );
        
        std::string cpu;
        long user, nice, system, idle, iowait, irq, softirq, steal;
        iss >> cpu >> user >> nice >> system >> idle >> iowait >> irq >> softirq >> steal;
        
        long total = user + nice + system + idle + iowait + irq + softirq + steal;
        long totalIdle = idle + iowait;
        
        long diffIdle = totalIdle - prevIdle;
        long diffTotal = total - prevTotal;
        
        double load = 0.0;
        if ( diffTotal > 0 ) {
            load = static_cast<double>( diffTotal - diffIdle ) / diffTotal;
        };
        
        prevIdle = totalIdle;
        prevTotal = total;
        return load;
    };
};

class BusyWork {
private:
    std::atomic<bool> running{ true };
    std::atomic<double> cpuGoal;
    std::atomic<double> gpuGoal;
    std::vector<std::thread> cpuThreads;
    std::vector<std::unique_ptr<std::atomic<bool>>> cpuThreadStates;
    std::thread monitorThread;
    
#ifdef ENABLE_CUDA
    std::vector<std::thread> gpuThreads;
    std::atomic<double> gpuDutyCycle{ 1.0 };
#endif
    
    int cpuCount;
    int gpuThreadCount;
    CpuMonitor cpuMonitor;
    
    // CPU intensive work
    void cpuWork( int threadId, std::atomic<bool>* active ) {
        ( void )threadId;
        double result = 0.0;
        while ( running ) {
            if ( *active ) {
                // Perform mathematical operations to generate heat
                for ( int i = 0; i < 100000; ++i ) {
                    result += std::sin( i ) * std::cos( i );
                    result = std::sqrt( std::abs( result ) );
                };
                volatile double sink = result;
                ( void )sink;
            } else {
                std::this_thread::sleep_for( std::chrono::milliseconds( 10 ) );
            };
        };
    };
    
    // Monitor and adjust workload
    void monitor() {
        std::this_thread::sleep_for( std::chrono::seconds( 1 ) );
        cpuMonitor.getCpuLoad();  // Prime the monitor
        
        while ( running ) {
            std::this_thread::sleep_for( std::chrono::seconds( 5 ) );
            
            double currentCpuLoad = cpuMonitor.getCpuLoad();
            double targetCpuLoad = cpuGoal.load();
            
            // Count active CPU threads
            int activeCount = 0;
            for ( const auto& state : cpuThreadStates ) {
                if ( *state ) activeCount++;
            };
            
            // Adjust CPU thread activity
            if ( currentCpuLoad < ( targetCpuLoad - 0.02 ) ) {
                // Need more heat - activate a thread
                if ( activeCount < static_cast<int>( cpuThreadStates.size() ) ) {
                    for ( auto& state : cpuThreadStates ) {
                        if ( !( *state ) ) {
                            *state = true;
                            activeCount++;
                            break;
                        };
                    };
                };
            } else if ( currentCpuLoad > ( targetCpuLoad + 0.02 ) ) {
                // Too much heat - deactivate a thread
                if ( activeCount > 0 ) {
                    for ( auto& state : cpuThreadStates ) {
                        if ( *state ) {
                            *state = false;
                            activeCount--;
                            break;
                        };
                    };
                };
            };
            
#ifdef ENABLE_CUDA
            double gpuLoad = getGpuLoad();
            double targetGpuLoad = gpuGoal.load();
            double duty = gpuDutyCycle.load();
            
            if ( gpuLoad < ( targetGpuLoad - 0.05 ) ) {
                duty += 0.05;
            } else if ( gpuLoad > ( targetGpuLoad + 0.05 ) ) {
                duty -= 0.05;
            };
            
            if ( duty > 1.0 ) duty = 1.0;
            if ( duty < 0.0 ) duty = 0.0;
            gpuDutyCycle.store( duty );
#endif
            
            printStatus( currentCpuLoad, targetCpuLoad, activeCount );
        };
    };
    
    void printStatus( double currentCpu, double targetCpu, int activeCpuThreads ) {
        std::cout << "[Status]" << std::endl;
        std::cout << "  CPU: " << ( currentCpu * 100.0 ) << "% / Target: " 
                  << ( targetCpu * 100.0 ) << "% | Active: " 
                  << activeCpuThreads << "/" << cpuThreadStates.size() << std::endl;
#ifdef ENABLE_CUDA
        std::cout << "  GPU: Duty Cycle: " << gpuDutyCycle.load() << std::endl;
#endif
        std::cout << "---" << std::endl;
    };
    
#ifdef ENABLE_CUDA
    void gpuWorker( int threadId ) {
        ( void )threadId;
        GpuContext* ctx = initGpu();
        if ( !ctx ) {
            std::cerr << "Failed to initialize GPU for thread " << threadId << std::endl;
            return;
        };
        
        const int blockSize = 256;
        const int gridSize = 1024;
        const int iterations = 100000;
        
        while ( running ) {
            double duty = gpuDutyCycle.load();
            
            if ( duty > 0.01 ) {
                launchGpuKernel( ctx, gridSize, blockSize, iterations );
                
                if ( duty < 0.99 ) {
                    int sleepMs = static_cast<int>( 50.0 * ( 1.0 - duty ) );
                    if ( sleepMs > 0 ) {
                        std::this_thread::sleep_for( std::chrono::milliseconds( sleepMs ) );
                    };
                };
            } else {
                std::this_thread::sleep_for( std::chrono::milliseconds( 50 ) );
            };
        };
        
        cleanupGpu( ctx );
    };
    
    double getGpuLoad() {
        return queryGpuLoad();
    };
#endif
    
public:
    BusyWork( double cpuGoalPercent, double gpuGoalPercent, int gpuThreads = 1 ) {
        cpuCount = std::thread::hardware_concurrency();
        gpuThreadCount = gpuThreads;
        
        // CPU goal is a fraction (0.0 to 1.0) of total CPU capacity
        if ( cpuGoalPercent > 0 ) {
            cpuGoal = cpuGoalPercent;
        } else {
            // Default: use cpucount-1 threads at max capacity
            cpuGoal = static_cast<double>( cpuCount - 1 ) / cpuCount;
        };
        
        gpuGoal = gpuGoalPercent > 0 ? gpuGoalPercent : 0.99;
        
        std::cout << "CPU cores detected: " << cpuCount << std::endl;
        std::cout << "CPU goal load: " << ( cpuGoal.load() * 100.0 ) << "%" << std::endl;
        std::cout << "GPU goal load: " << ( gpuGoal.load() * 100.0 ) << "%" << std::endl;
        std::cout << "GPU threads: " << gpuThreadCount << std::endl;
    };
    
    ~BusyWork() {
        stop();
    };
    
    void start() {
        // Start CPU threads - create max threads, control via active flags
        int threadsToStart = ( cpuCount > 1 ) ? ( cpuCount - 1 ) : 1;
        for ( int i = 0; i < threadsToStart; ++i ) {
            cpuThreadStates.push_back( std::make_unique<std::atomic<bool>>( true ) );
            cpuThreads.emplace_back( &BusyWork::cpuWork, this, i, cpuThreadStates.back().get() );
        };
        
#ifdef ENABLE_CUDA
        // Start GPU threads
        for ( int i = 0; i < gpuThreadCount; ++i ) {
            gpuThreads.emplace_back( &BusyWork::gpuWorker, this, i );
        };
#endif
        
        // Start monitor thread
        monitorThread = std::thread( &BusyWork::monitor, this );
        
        std::cout << "Started " << threadsToStart << " CPU worker threads" << std::endl;
#ifdef ENABLE_CUDA
        std::cout << "Started " << gpuThreadCount << " GPU worker threads" << std::endl;
#endif
    };
    
    void stop() {
        running = false;
        
        for ( auto& thread : cpuThreads ) {
            if ( thread.joinable() ) {
                thread.join();
            };
        };
        
#ifdef ENABLE_CUDA
        for ( auto& thread : gpuThreads ) {
            if ( thread.joinable() ) {
                thread.join();
            };
        };
#endif
        
        if ( monitorThread.joinable() ) {
            monitorThread.join();
        };
    };
    
    void waitForSignal() {
        std::cout << "Press Enter to stop..." << std::endl;
        std::cin.get();
        stop();
    };
};

void printUsage( const char* programName ) {
    std::cout << "Usage: " << programName << " [OPTIONS]" << std::endl;
    std::cout << "Options:" << std::endl;
    std::cout << "  --cpugoal N.NN       CPU utilization goal 0.0-1.0 (default: (cpucount-1)/cpucount)" << std::endl;
    std::cout << "  --gpugoal N.NN       GPU utilization goal 0.0-1.0 (default: 0.99)" << std::endl;
    std::cout << "  --gputhreads N       Number of GPU worker threads (default: 1)" << std::endl;
    std::cout << "  -h, --help           Show this help message" << std::endl;
};

int main( int argc, char* argv[] ) {
    double cpuGoal = -1.0;  // -1 means use default
    double gpuGoal = -1.0;  // -1 means use default
    int gpuThreads = 1;
    
    static struct option longOptions[] = {
        { "cpugoal", required_argument, 0, 'c' },
        { "gpugoal", required_argument, 0, 'g' },
        { "gputhreads", required_argument, 0, 't' },
        { "help", no_argument, 0, 'h' },
        { 0, 0, 0, 0 }
    };
    
    int opt;
    int optionIndex = 0;
    
    while ( ( opt = getopt_long( argc, argv, "hc:g:t:", longOptions, &optionIndex ) ) != -1 ) {
        switch ( opt ) {
            case 'c':
                cpuGoal = std::stod( optarg );
                break;
            case 'g':
                gpuGoal = std::stod( optarg );
                break;
            case 't':
                gpuThreads = std::stoi( optarg );
                break;
            case 'h':
                printUsage( argv[0] );
                return 0;
            default:
                printUsage( argv[0] );
                return 1;
        };
    };
    
    BusyWork busy( cpuGoal, gpuGoal, gpuThreads );
    busy.start();
    busy.waitForSignal();
    
    return 0;
};
